---
import PageHead from '@/components/PageHead.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/Section.astro'
import IndexRow from '@/components/IndexRow.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

/*
	The coloured icon tiles are gone on purpose. The index contains no icons at
	all — its whole containment vocabulary is hairlines — so a grid of brand
	colours here was the loudest thing on the site and belonged to a different
	one. A tool is a row, like a project and a role.
*/
interface Tool {
	name: string
	description: string
	href: string
	host: string
}

const GROUPS: { title: string; unit: string; tools: Tool[] }[] = [
	{
		title: 'Desarrollo',
		unit: 'herramientas',
		tools: [
			{
				name: 'VS Code',
				description: 'Editor de código',
				href: 'https://code.visualstudio.com/',
				host: 'code.visualstudio.com'
			},
			{
				name: 'GitHub',
				description: 'Control de versiones y CI',
				href: 'https://github.com/',
				host: 'github.com'
			},
			{
				name: 'Payload',
				description: 'CMS sobre Node, para contenido que el cliente administra',
				href: 'https://payloadcms.com/',
				host: 'payloadcms.com'
			},
			{
				name: 'Strapi',
				description: 'CMS headless',
				href: 'https://strapi.io/',
				host: 'strapi.io'
			},
			{
				name: 'Postman',
				description: 'Pruebas de API',
				href: 'https://www.postman.com/',
				host: 'postman.com'
			},
			{
				name: 'Docker',
				description: 'Entornos reproducibles',
				href: 'https://www.docker.com/',
				host: 'docker.com'
			},
			{
				name: 'Vercel',
				description: 'Despliegue — incluido este sitio',
				href: 'https://vercel.com/',
				host: 'vercel.com'
			}
		]
	},
	{
		title: 'Diseño',
		unit: 'herramientas',
		tools: [
			{
				name: 'Figma',
				description: 'Diseño de interfaces',
				href: 'https://www.figma.com/',
				host: 'figma.com'
			}
		]
	},
	{
		title: 'Productividad',
		unit: 'herramientas',
		tools: [
			{
				name: 'Notion',
				description: 'Organización y notas',
				href: 'https://www.notion.so/product',
				host: 'notion.so'
			},
			{
				name: 'Slack',
				description: 'Comunicación con equipos y clientes',
				href: 'https://slack.com/',
				host: 'slack.com'
			}
		]
	}
]
---

<PageLayout meta={{ title: t('nav.tools'), description: t('tools.lede') }}>
	<PageHead title={t('nav.tools')} lede={t('tools.lede')} backHref='/' backLabel={t('back.home')} />

	{
		GROUPS.map((group, i) => (
			<Section
				class='mt-16 sm:mt-20'
				title={group.title}
				count={group.tools.length}
				unit={group.unit}
				style={`--i: ${i + 2}`}
			>
				{group.tools.map((tool) => (
					<IndexRow
						title={tool.name}
						meta={tool.host}
						description={tool.description}
						href={tool.href}
						external
					/>
				))}
			</Section>
		))
	}
</PageLayout>

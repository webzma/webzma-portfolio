---
import PageHead from '@/components/PageHead.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts, getUniqueTagsWithCount } from '@/utils'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const allPosts = await getAllPosts()
const allTags = getUniqueTagsWithCount(allPosts)

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const meta = {
	description: t('tags.lede'),
	title: t('tags.title')
}
---

<PageLayout meta={meta}>
	<PageHead
		title={t('tags.title')}
		lede={t('tags.lede')}
		backHref='/blog/'
		backLabel={t('blog.back')}
	/>

	{allTags.length === 0 && <p class='empty'>{t('tags.empty')}</p>}

	{
		/* A tag with its count is a spec row: key left, tabular number right.
		   Same shape as the index's proof column. */
		allTags.length > 0 && (
			<dl class='spec reveal mt-10' style='--i: 2'>
				{allTags.map(([tag, count]) => (
					<div class='spec__row'>
						<dt>
							<a class='tag' href={`/tags/${tag}/`} data-astro-prefetch>
								<span class='tag__hash' aria-hidden='true'>
									#
								</span>
								{tag}
							</a>
						</dt>
						<dd class='spec__value'>
							<span class='mono-label'>
								{String(count).padStart(2, '0')} {count === 1 ? t('tags.post') : t('tags.posts')}
							</span>
						</dd>
					</div>
				))}
			</dl>
		)
	}
</PageLayout>

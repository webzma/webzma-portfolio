---
import PageLayout from '@/layouts/BaseLayout.astro'
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

/*
	The template's "Get free template" badge and its pinging green dot lived
	here. A 404 is the page a stranger is most likely to hit by accident, so it
	is the last place to advertise the theme somebody else wrote.
*/
---

<PageLayout meta={{ title: '404', description: t('nf.lede') }}>
	<section class='diptych reveal' style='--i: 1'>
		<div>
			<p class='hero__eyebrow'>
				<span class='hero__tick' aria-hidden='true'></span>
				<span class='mono-label'>Error 404</span>
			</p>

			<h1 class='hero__title'>{t('nf.title')}</h1>
			<p class='hero__lede'>{t('nf.lede')}</p>

			<p class='mt-8'>
				<a class='backlink' href={translatePath('/')} data-astro-prefetch>
					<span class='backlink__arrow' aria-hidden='true'>&#8592;</span>
					{t('nf.back')}
				</a>
			</p>
		</div>

		<!--
			One row, three links — the same shape as the index's "Enlaces" row.
			A label column that just repeats each destination's name in both
			cells is a table pretending to be information.
		-->
		<dl class='spec'>
			<div class='spec__row'>
				<dt class='mono-label'>{t('nf.goto')}</dt>
				<dd class='spec__value spec__links'>
					<a
						class='link whitespace-nowrap'
						href={`${translatePath('/')}#trabajo`}
						data-astro-prefetch
					>
						{t('work.title')}
					</a>
					<a class='link whitespace-nowrap' href='/blog/' data-astro-prefetch>{t('nav.blog')}</a>
					<a class='link whitespace-nowrap' href='/tools/' data-astro-prefetch>{t('nav.tools')}</a>
				</dd>
			</div>
		</dl>
	</section>
</PageLayout>

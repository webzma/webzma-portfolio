---
import { cn } from '@/utils'

interface Props {
	title: string
	count?: number
	unit?: string
	id?: string
	class?: string
	style?: string
}

const { class: className, title, count, unit, id, style } = Astro.props
---

<!--
	S3 · Sticky pinned section head, laid out as a Split Studio diptych: the
	label pins to the left half while the rows scroll past on the right. Under
	768px it collapses to a stacked head above the list. The label is the
	heading itself — no eyebrow, no numeral, no tag-left / heading-right grid.
-->
<section class={cn(className, 'section reveal')} id={id} style={style}>
	<div class='section__aside'>
		<h2 class='section__label'>{title}</h2>
		{
			count !== undefined && (
				<span class='section__count'>
					{String(count).padStart(2, '0')}
					{unit && <span class='ml-1 normal-case tracking-normal'>{unit}</span>}
				</span>
			)
		}
	</div>

	<div class='section__body'>
		<slot />
	</div>
</section>

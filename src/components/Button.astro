---
import { cn } from '@/utils'

// Cobalt voice: 6px radius drawn with a ruler, never a pill, never a gradient.
// `style` is kept for the blog / tools / 404 call sites; `pill` now resolves to
// the same tight radius rather than a rounded capsule.
const { as: Tag = 'a', class: className, title, href, style = 'button' } = Astro.props
---

<Tag
	class={cn(
		className,
		'btn',
		style === 'primary' ? 'btn--primary' : 'btn--ghost',
		!href && 'cursor-default'
	)}
	href={href}
	data-astro-prefetch
>
	<slot name='icon-before' />
	<span>{title}</span>
	<slot name='icon-after' />
</Tag>

---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@/i18n/utils'
import { projects, experience, education, socials, now, contact } from '@/i18n/ui'
import type { ProjectEntry } from '@/i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)

const work = projects[lang]
const roles = experience[lang]
const study = education[lang]
const nowEntry = now[lang]

/* Stamps are stored as YYYY-MM so they stay sortable; the changelog prints
   them as calendar versions (2025-10 → v2025.10). */
const version = (stamp: string) => `v${stamp.replace('-', '.')}`

/* Day 1 at noon UTC keeps the month from slipping a timezone backwards. */
const nowLabel = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'es-ES', {
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC'
}).format(new Date(`${nowEntry.stamp}-01T12:00:00Z`))

/* A project tied to a role ships inside that version of the log; the rest
   keep their own list above it, so nothing is ever dropped from the page. */
const loose = work.filter((project) => !project.at)
const shippedUnder = (id: string) => work.filter((project) => project.at === id)

const projectLink = (project: ProjectEntry) => ({
	href: project.study ? translatePath(`/work/${project.slug}/`) : project.href,
	external: !project.study
})
---

<!--
	Changelog. The page is a release log of a career: `whoami` up top, an
	optional `ls` of client work, then `git log` from HEAD (the dated "Ahora"
	note) back to the first commit (the degree). Every version number is a
	real start date, never decoration.
-->
<section class='whoami reveal' style='--i: 1'>
	<p class='prompt'><span class='prompt__sign' aria-hidden='true'>$</span> whoami</p>

	<h1 class='whoami__name'>{t('hero.name')}</h1>
	<p class='whoami__role'>{t('hero.role')}</p>

	<p class='whoami__lede'>{t('hero.intro')}</p>
	<p class='whoami__sub'>{t('hero.intro2')}</p>

	<!--
		The address is copyable rather than a mailto: — a mailto opens
		whatever client the machine happens to have registered, which on a
		work laptop is usually the wrong one. Copying always works.
	-->
	<dl class='facts'>
		<div class='facts__row'>
			<dt class='facts__key'>{t('meta.status')}</dt>
			<dd class='facts__value facts__value--live'>
				<span class='spec__dot' aria-hidden='true'></span>{t('hero.status')}
			</dd>
		</div>

		<div class='facts__row'>
			<dt class='facts__key'>{t('meta.location')}</dt>
			<dd class='facts__value'>{t('hero.base')}</dd>
		</div>

		<div class='facts__row'>
			<dt class='facts__key'>{t('meta.email')}</dt>
			<dd class='facts__value'>
				<button
					class='copy'
					type='button'
					data-copy={contact.email}
					data-label-idle={t('copy.hint')}
					data-label-done={t('copy.done')}
				>
					<span>{contact.email}</span>
					<span class='copy__hint' aria-hidden='true'>{t('copy.hint')}</span>
				</button>
				<span class='sr-only' role='status' data-copy-status></span>
			</dd>
		</div>

		<div class='facts__row'>
			<dt class='facts__key'>{t('meta.links')}</dt>
			<dd class='facts__value facts__links'>
				{
					socials.map((social) => (
						<a
							class='link whitespace-nowrap'
							href={social.href}
							target='_blank'
							rel='noopener noreferrer'
						>
							{social.label}
							<span class='row__arrow' aria-hidden='true'>
								&nbsp;&#8599;&#xFE0E;
							</span>
						</a>
					))
				}
			</dd>
		</div>
	</dl>
</section>

{
	loose.length > 0 && (
		<section class='reveal block' id='trabajo' style='--i: 2'>
			<header class='block__head'>
				<p class='prompt'>
					<span class='prompt__sign' aria-hidden='true'>
						$
					</span>{' '}
					ls ./{t('work.title').toLowerCase()}
				</p>
				<h2 class='block__title'>{t('work.title')}</h2>
				<p class='block__lede'>
					{t('work.lede')}{' '}
					<span class='block__count'>
						{String(loose.length).padStart(2, '0')} {t('work.unit')}
					</span>
				</p>
			</header>

			<ul class='ls'>
				{loose.map((project) => {
					const { href, external } = projectLink(project)
					return (
						<li>
							<a
								class='ls__row'
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								data-astro-prefetch={external ? undefined : true}
							>
								<span class='ls__name'>
									{project.name}
									{external && (
										<span class='row__arrow' aria-hidden='true'>
											&nbsp;&#8599;&#xFE0E;
										</span>
									)}
								</span>
								<span class='ls__host'>{project.host}</span>
								<span class='ls__desc'>{project.description}</span>
								<span class='ls__stack'>
									{project.status === 'archived' && (
										<span class='ls__archived'>{t('status.archived')} · </span>
									)}
									{project.stack}
								</span>
							</a>
						</li>
					)
				})}
			</ul>
		</section>
	)
}

<section class='reveal block' id='changelog' style='--i: 3'>
	<header class='block__head'>
		<p class='prompt'><span class='prompt__sign' aria-hidden='true'>$</span> git log</p>
		<h2 class='block__title'>{t('log.title')}</h2>
		<p class='block__lede'>{t('log.lede')}</p>
	</header>

	<ol class='log'>
		<!--
			HEAD is the "Ahora" note: the only entry that goes stale on its own,
			which is why it carries its own date stamp.
		-->
		<li class='log__entry log__entry--head' id='ahora'>
			<div class='log__ver'>
				<span class='log__num'>{version(nowEntry.stamp)}</span>
				<span class='log__when'>HEAD · {t('log.head')}</span>
			</div>
			<div class='log__body'>
				<h3 class='log__title'>{t('now.title')}</h3>
				<p class='log__text'>{nowEntry.note}</p>
				<ul class='log__changes'>
					{
						nowEntry.items.map((item) => (
							<li>
								<span class='log__plus' aria-hidden='true'>
									+
								</span>
								<span>
									<span class='log__key'>{item.label}</span> {item.value}
								</span>
							</li>
						))
					}
				</ul>
				<p class='log__stamp'>
					{t('now.stamp')} · <time datetime={nowEntry.stamp}>{nowLabel}</time>
				</p>
			</div>
		</li>

		{
			roles.map((role) => {
				const shipped = shippedUnder(role.id)
				return (
					<li class='log__entry' id={role.id}>
						<div class='log__ver'>
							<span class='log__num'>{version(role.start)}</span>
							<span class='log__when'>{role.date}</span>
						</div>
						<div class='log__body'>
							<h3 class='log__title'>{role.title}</h3>
							<p class='log__sub'>{role.company}</p>
							<p class='log__text'>{role.description}</p>
							{shipped.length > 0 && (
								<ul class='log__changes' aria-label={t('log.shipped')}>
									{shipped.map((project) => {
										const { href, external } = projectLink(project)
										return (
											<li>
												<span class='log__plus' aria-hidden='true'>
													+
												</span>
												<span>
													<a
														class='link'
														href={href}
														target={external ? '_blank' : undefined}
														rel={external ? 'noopener noreferrer' : undefined}
													>
														{project.name}
													</a>{' '}
													<span class='log__dim'>
														{project.host} · {project.stack}
													</span>
												</span>
											</li>
										)
									})}
								</ul>
							)}
						</div>
					</li>
				)
			})
		}

		<li class='log__entry' id='educacion'>
			<div class='log__ver'>
				<span class='log__num'>{version(study.start)}</span>
				<span class='log__when'>{study.date}</span>
			</div>
			<div class='log__body'>
				<h3 class='log__title'>{study.degree}</h3>
				<p class='log__sub'>{study.school}</p>
			</div>
		</li>
	</ol>
</section>

<script>
	/* ── Copy-to-clipboard ───────────────────────────────────────────────── */
	function bindCopy() {
		document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
			if (btn.dataset.bound === 'true') return
			btn.dataset.bound = 'true'

			const hint = btn.querySelector<HTMLElement>('.copy__hint')
			const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]')
			let timer: number | undefined

			btn.addEventListener('click', async () => {
				const value = btn.dataset.copy
				if (!value) return

				try {
					await navigator.clipboard.writeText(value)
				} catch {
					/* Insecure context or a denied permission — select the text so
					   the visitor can still copy it by hand instead of nothing
					   happening at all. */
					const range = document.createRange()
					range.selectNodeContents(btn)
					const sel = window.getSelection()
					sel?.removeAllRanges()
					sel?.addRange(range)
					return
				}

				const done = btn.dataset.labelDone ?? 'Copied'
				const idle = btn.dataset.labelIdle ?? 'Copy'
				btn.dataset.copied = 'true'
				if (hint) hint.textContent = done
				if (status) status.textContent = `${done}: ${value}`

				window.clearTimeout(timer)
				timer = window.setTimeout(() => {
					btn.dataset.copied = 'false'
					if (hint) hint.textContent = idle
					if (status) status.textContent = ''
				}, 2000)
			})
		})
	}

	bindCopy()
	document.addEventListener('astro:after-swap', bindCopy)
</script>

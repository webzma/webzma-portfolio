---
import { socials, contact } from '@/i18n/ui'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const year = new Date().getFullYear()
const linkedin = socials.find((s) => s.label === 'LinkedIn')
const elsewhere = socials.filter((s) => s.label !== 'LinkedIn')
---

<!--
	Ft5 · Statement, set on the page's one dark beat. Cobalt is a light theme
	with a single graphite band, not a dark theme — the band closes the page
	and gives it a light → dark rhythm. One closing sentence, one action, then
	a hairline and the credits. No sitemap columns, no social-icon row.
-->
<footer class='band reveal' style='--i: 5'>
	<div class='shell py-20 sm:py-28'>
		<p class='band__statement'>{t('footer.statement')}</p>

		{
			linkedin && (
				<p class='mt-8 text-sm'>
					<a
						class='band__link whitespace-nowrap'
						href={linkedin.href}
						target='_blank'
						rel='noopener noreferrer'
					>
						{t('footer.cta')}
						<span aria-hidden='true'>&nbsp;&#8599;&#xFE0E;</span>
					</a>
				</p>
			)
		}

		<!--
			The colophon. What the page is actually made of, stated plainly —
			the most honest thing a developer's site can print, and the one
			claim on it a reader can verify by pressing Ctrl+U.
		-->
		<div
			class='band__meta mt-16 flex flex-col gap-y-5 pt-6 sm:mt-20 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-10'
		>
			<div>
				<p class='mono-label'>Wilberk Ledezma · Venezuela · {year}</p>
				<p class='colophon'>
					{t('footer.colophon')}{' '}
					<a
						class='band__nav-link whitespace-nowrap'
						href={contact.source}
						target='_blank'
						rel='noopener noreferrer'
					>
						{t('footer.source')}
						<span aria-hidden='true'>&nbsp;&#8599;&#xFE0E;</span>
					</a>
				</p>
			</div>

			<nav
				class='flex flex-wrap items-baseline gap-x-5 gap-y-2 text-sm'
				aria-label={t('footer.elsewhere')}
			>
				{
					/* Not translatePath(): the blog and the tools list are only
					   built unprefixed, so /en/blog/ was a 404 for every English
					   visitor who clicked here. When those pages get an English
					   build, put translatePath back. */
				}
				<a class='band__nav-link whitespace-nowrap' href='/blog/'>
					{t('nav.blog')}
				</a>
				<a class='band__nav-link whitespace-nowrap' href='/tools/'>
					{t('nav.tools')}
				</a>
				{
					elsewhere.map((social) => (
						<a
							class='band__nav-link whitespace-nowrap'
							href={social.href}
							target='_blank'
							rel='noopener noreferrer'
						>
							{social.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>

---
import type { TocItem } from '@/utils'

interface Props {
	heading: TocItem
}

const {
	heading: { depth, slug, subheadings, text }
} = Astro.props
---

<li>
	<a class='toc__link' data-depth={depth} href={`#${slug}`}>{text}</a>
	{
		!!subheadings.length && (
			<ul class='toc__list'>
				{subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>

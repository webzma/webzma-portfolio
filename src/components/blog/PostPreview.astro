---
import type { CollectionEntry } from 'astro:content'

import FormattedDate from '../FormattedDate.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

interface Props {
	post: CollectionEntry<'post'>
	withDesc?: boolean
}

const { post, withDesc = false } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const postDate = post.data.updatedDate ?? post.data.publishDate
const isUpdated = Boolean(post.data.updatedDate)
---

<!--
	A post is the same row as a project or a role: title left, tabular date
	right, description under. The list needs no separate visual language.
-->
<li>
	<a class='row' href={`/blog/${post.slug}/`} data-astro-prefetch>
		<div class='row__head'>
			<h3 class='row__title'>{post.data.title}</h3>
			<span class='row__meta'>
				{isUpdated && `${t('blog.updated')} · `}<FormattedDate date={postDate} />
			</span>
		</div>

		{withDesc && <p class='row__body'>{post.data.description}</p>}

		{
			(post.data.draft || post.data.tags.length > 0) && (
				<p class='row__facts'>
					{post.data.draft && <span class='row__status'>{t('blog.draft')}</span>}
					{post.data.tags.map((tag, i) => (
						<>
							{(i > 0 || post.data.draft) && (
								<span class='row__sep' aria-hidden='true'>
									/
								</span>
							)}
							<span>{tag}</span>
						</>
					))}
				</p>
			)
		}
	</a>
</li>

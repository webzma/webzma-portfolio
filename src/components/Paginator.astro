---
import type { PaginationLink } from '@/types'

interface Props {
	nextUrl?: PaginationLink
	prevUrl?: PaginationLink
}

const { nextUrl, prevUrl } = Astro.props
---

<!--
	Two typographic links on a hairline. The arrow leads on the way back and
	trails on the way forward, so direction reads before the word does.
-->{
	(prevUrl || nextUrl) && (
		<nav class='pager'>
			{prevUrl && (
				<a class='backlink' href={prevUrl.url} data-astro-prefetch>
					<span class='backlink__arrow' aria-hidden='true'>
						&#8592;
					</span>
					{prevUrl.srLabel && <span class='sr-only'>{prevUrl.srLabel}</span>}
					{prevUrl.text ?? 'Previous'}
				</a>
			)}

			{nextUrl && (
				<a class='backlink pager__spacer' href={nextUrl.url} data-astro-prefetch>
					{nextUrl.srLabel && <span class='sr-only'>{nextUrl.srLabel}</span>}
					{nextUrl.text ?? 'Next'}
					<span aria-hidden='true'>&#8594;</span>
				</a>
			)}
		</nav>
	)
}

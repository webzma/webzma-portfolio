---
import type { CollectionEntry } from 'astro:content'

import BlogHero from '@/components/blog/Hero.astro'
import TOC from '@/components/blog/TOC.astro'
import PageLayout from './BaseLayout.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

interface Props {
	post: CollectionEntry<'post'>
}

const { post } = Astro.props
const {
	data: { description, ogImage, publishDate, title, updatedDate },
	slug
} = post

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const socialImage = ogImage ?? `/og-image/${slug}.png`
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const { headings } = await post.render()
---

<PageLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<div class='reveal' style='--i: 1'>
		<a class='backlink' href='/blog/' data-astro-prefetch>
			<span class='backlink__arrow' aria-hidden='true'>&#8592;</span>
			{t('blog.back')}
		</a>
	</div>

	<!--
		The article and its contents are a diptych too, just weighted the other
		way: the prose takes the wide half and the pinned index the narrow one.
		Under 1024px the TOC hides itself and the article is a single column.
	-->
	<div class='reveal mt-8 gap-x-12 lg:flex lg:items-start' style='--i: 2'>
		<TOC headings={headings} />

		<article class='min-w-0 flex-grow break-words' data-pagefind-body>
			<div id='blog-hero'><BlogHero content={post} /></div>

			<div class='prose prose-base mt-12 dark:prose-invert'>
				<slot />
			</div>
		</article>
	</div>

	<button aria-label={t('top')} class='to-top' data-show='false' id='to-top-btn' type='button'>
		<svg
			aria-hidden='true'
			class='h-4 w-4'
			fill='none'
			focusable='false'
			stroke='currentColor'
			stroke-width='1.75'
			viewBox='0 0 24 24'
			xmlns='http://www.w3.org/2000/svg'
		>
			<path d='M4.5 15.75l7.5-7.5 7.5 7.5' stroke-linecap='round' stroke-linejoin='round'></path>
		</svg>
	</button>
</PageLayout>

<script>
	/* Re-bound on every navigation: with the view transitions router the
	   document persists across routes, so a one-shot listener would go stale
	   the first time a visitor clicks through to another post. */
	let observer: IntersectionObserver | undefined

	function bindToTop() {
		observer?.disconnect()

		const scrollBtn = document.getElementById('to-top-btn')
		const targetHeader = document.getElementById('blog-hero')
		if (!scrollBtn || !targetHeader) return

		scrollBtn.addEventListener('click', () => {
			document.documentElement.scrollTo({ behavior: 'smooth', top: 0 })
		})

		/* Only show the button once the article head is out of view. */
		observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				scrollBtn.dataset.show = String(!entry.isIntersecting)
			})
		})
		observer.observe(targetHeader)
	}

	bindToTop()
	document.addEventListener('astro:after-swap', bindToTop)
</script>
